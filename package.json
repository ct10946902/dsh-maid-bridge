{
  "name": "dsh-maid-bridge",
  "version": "0.1.0",
  "description": "车万女仆 mod 的 OpenAI 兼容本地桥：把游戏里女仆说的话投递给指定 DSH 会话，再把回复带回去。只绑 127.0.0.1，密钥 + 会话白名单 + 限流。",
  "meta": {
    "title": "（联动）车万女仆桥",
    "description": "Minecraft 车万女仆 mod ↔ DSH 会话的本地 OpenAI 兼容接口；只走本机、要密钥、可限会话。"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "openai-compatible",
    "minecraft",
    "touhou-little-maid"
  ],
  "author": "沈汀",
  "license": "MIT"
}
